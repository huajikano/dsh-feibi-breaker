{
  "name": "feibi-breaker",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "菲比破限：系统提示词整形 + 提交前拦截，适配 DeepSeek-Harness 0.2.x。与 dsh-gatekeeper 等拦截插件共存，安装只改动本插件自己的一行。",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "refusal",
    "guard",
    "armor"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./core/payload.bin": "./core/payload.bin",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "core",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts",
    "tools",
    "test",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "harness:check": "node --check lib/index.js && node --check lib/stream.js && node --check client.js",
    "launchers": "node tools/write-launchers.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "node --test test/*.test.mjs && node tools/check-install.mjs"
  },
  "dsh": {
    "id": "feibi-breaker",
    "name": "菲比破限",
    "version": "1.2.0",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
